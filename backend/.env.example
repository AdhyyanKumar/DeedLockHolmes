PORT=5000
FRONTEND_URL=https://deed-lock-holmes.vercel.app
BACKEND_PUBLIC_URL=https://deed-lock-holmes.vercel.app
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://deed-lock-holmes.vercel.app/api/auth/google/callback

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash-002
GEMINI_MODEL_PRO_FALLBACKS=gemini-2.5-pro,gemini-1.5-pro-002,gemini-1.5-pro-latest
GEMINI_TIMEOUT=30000
GEMINI_MAX_DEED_CHARS=12000

MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=deedlock_holmes
MONGODB_REQUIRED=true
MONGODB_FORCE_IPV4=true
MONGODB_TLS_INSECURE=false
